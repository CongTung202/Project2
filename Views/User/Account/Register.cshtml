@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="card-title text-primary">Đăng ký tài khoản</h2>
                        <p class="text-muted">Tạo tài khoản để bắt đầu mua sắm</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" action="/Account/Register">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Họ tên *</label>
                            <input name="HoTen" type="text" class="form-control" required
                                   placeholder="Nhập họ tên đầy đủ">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <input name="Email" type="email" class="form-control" required
                                   placeholder="example@email.com">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu *</label>
                            <input name="MatKhau" type="password" class="form-control" required
                                   placeholder="Ít nhất 6 ký tự">
                            <div class="form-text">Ít nhất 6 ký tự</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Xác nhận mật khẩu *</label>
                            <input name="ConfirmPassword" type="password" class="form-control" required
                                   placeholder="Nhập lại mật khẩu">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Điện thoại</label>
                            <input name="DienThoai" type="tel" class="form-control"
                                   placeholder="Số điện thoại (tùy chọn)">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <input name="DiaChi" type="text" class="form-control"
                                   placeholder="Địa chỉ (tùy chọn)">
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                            <label class="form-check-label small" for="agreeTerms">
                                Tôi đồng ý với <a href="#" class="text-primary">Điều khoản dịch vụ</a> và <a href="#" class="text-primary">Chính sách bảo mật</a>
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                            <i class="bi bi-person-plus me-2"></i>Đăng ký
                        </button>

                        <div class="text-center">
                            <span class="text-muted">Đã có tài khoản?</span>
                            <a href="/Account/Login" class="ms-2 text-primary">Đăng nhập ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Basic form validation
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const password = document.querySelector('input[name="MatKhau"]');
            const confirmPassword = document.querySelector('input[name="ConfirmPassword"]');

            form.addEventListener('submit', function(e) {
                let isValid = true;

                // Check required fields
                const requiredFields = form.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        isValid = false;
                        field.classList.add('is-invalid');
                    } else {
                        field.classList.remove('is-invalid');
                    }
                });

                // Check password match
                if (password.value !== confirmPassword.value) {
                    isValid = false;
                    confirmPassword.classList.add('is-invalid');
                    alert('Mật khẩu xác nhận không khớp!');
                } else {
                    confirmPassword.classList.remove('is-invalid');
                }

                // Check password length
                if (password.value.length < 6) {
                    isValid = false;
                    password.classList.add('is-invalid');
                    alert('Mật khẩu phải có ít nhất 6 ký tự!');
                } else {
                    password.classList.remove('is-invalid');
                }

                // Check terms agreement
                const agreeTerms = document.getElementById('agreeTerms');
                if (!agreeTerms.checked) {
                    isValid = false;
                    agreeTerms.classList.add('is-invalid');
                    alert('Vui lòng đồng ý với điều khoản dịch vụ!');
                } else {
                    agreeTerms.classList.remove('is-invalid');
                }

                if (!isValid) {
                    e.preventDefault();
                }
            });
        });
    </script>

    <style>
        .card {
            border-radius: 15px;
        }

        .form-control {
            border-radius: 8px;
            padding: 0.75rem 1rem;
        }

        .btn-primary {
            background: #ff6b35;
            border: none;
            border-radius: 8px;
            font-weight: 600;
        }

        .is-invalid {
            border-color: #dc3545;
        }
    </style>
}