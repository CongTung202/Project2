@model Project2_QuanLyTapHoa.Models.SanPham

@{
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container my-5">
    <div class="row g-4">
        <!-- Hình ảnh sản phẩm -->
        <div class="col-md-5">
            <div class="border rounded shadow-sm p-2 bg-white d-flex justify-content-center" >
                <img src="@Model.HinhAnh" class="img-fluid rounded" alt="@Model.TenSp"
                     style="max-height: 400px; object-fit: contain;" />
            </div>
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-7">
            <h2 class="fw-bold mb-3" style="color:#C0392B;">@Model.TenSp</h2>
            <p class="text-muted">Loại: <b>@Model.MaLoaiNavigation?.TenLoai</b></p>
            <p class="mb-4">@Model.MoTa</p>

            <h3 class="fw-bold mb-3" style="color:#C0392B;">
                @Model.DonGia.ToString("N0") đ
            </h3>

            <p class="mb-4">Còn lại: <span class="fw-bold">@Model.SoLuong</span></p>

            <!-- Nút hành động -->
            <div class="d-flex gap-3">
                <button class="btn btn-outline-danger px-4 py-2">
                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                </button>
                <a href="#" class="btn btn-danger px-4 py-2">
                    <i class="bi bi-lightning-charge"></i> Mua ngay
                </a>
            </div>
        </div>
    </div>
</div>
