@model IEnumerable<Project2_QuanLyTapHoa.Models.SanPham>

@{
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <h2 class="mb-3 text-danger fw-bold">Danh sách sản phẩm</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow border-0" style="border-radius: 15px; overflow: hidden;">
                    <img src="@item.HinhAnh" class="card-img-top" alt="@item.TenSp"
                         style="height:200px; object-fit:cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-danger">@item.TenSp</h5>
                        <p class="card-text text-truncate">@item.MoTa</p>
                        <p class="fw-bold text-danger fs-5">@item.DonGia.ToString("N0") đ</p>
                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.MaSp"
                               class="btn btn-outline-danger flex-fill">
                                Xem chi tiết
                            </a>
                            <a href="#" class="btn btn-danger flex-fill">
                                Mua ngay
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
